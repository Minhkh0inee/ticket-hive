# PostgreSQL — Neon (cloud)
DATABASE_URL=postgresql://username:password@ep-xxxx.us-east-1.aws.neon.tech/tickethive?sslmode=require

# Redis — local Docker
REDIS_URL=redis://localhost:6379

# Elasticsearch — local Docker
ELASTICSEARCH_URL=http://localhost:9200

# RabbitMQ — local Docker
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here

# Seat Lock
SEAT_LOCK_TTL_SECONDS=600

# Frontend
VITE_API_URL=http://localhost:8080
VITE_ENABLE_MSW=true
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key
VITE_CLOUDINARY_API_SECRET=your_cloudinary_api_secret
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

FRONTEND_URL=your_production_url